                                                            <TextBlock Text="70" Foreground="#90A6B7" FontSize="9" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="75" Foreground="#90A6B7" FontSize="9" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="80" Foreground="#90A6B7" FontSize="9" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="85" Foreground="#90A6B7" FontSize="9" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="90" Foreground="#90A6B7" FontSize="9" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="95" Foreground="#90A6B7" FontSize="9" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="100" Foreground="#90A6B7" FontSize="9" HorizontalAlignment="Right"/>
                                                        </UniformGrid>
                                                    </Grid>
                                                    <TextBox Grid.Row="1"
                                                             Grid.Column="2"
                                                             Text="{Binding SinglePartSimilarityThresholdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource DarkTextBox}"
                                                             Width="54"
                                                             Height="26"
                                                             HorizontalAlignment="Right"/>
                                                </Grid>
                                                <WrapPanel Margin="0,10,0,0">
                                                    <Button Content="설정 저장"
                                                            Style="{StaticResource NavButton}"
                                                            Width="92"
                                                            Height="28"
                                                            Command="{Binding SaveInspectionScoreSettingsCommand}"/>
                                                    <TextBlock Text="{Binding InspectionScoreSettingsMessage}"
                                                               Foreground="#F3D36B"
                                                               VerticalAlignment="Center"
                                                               Margin="10,0,0,0"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="자동기능 학습"
                                                   Style="{StaticResource SectionTitle}"/>
                                        <WrapPanel Margin="0,8,0,8">
                                            <Button Content="학습 바로시작"
                                                    Style="{StaticResource NavButton}"
                                                    Width="120"
                                                    Height="30"
                                                    Margin="0,0,12,0"
                                                    Command="{Binding StartImageTrainingCommand}"/>
                                            <CheckBox Content="1회 예약"
                                                      IsChecked="{Binding IsTrainingReservationEnabled, Mode=TwoWay}"
                                                      Foreground="#DDE7EF"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0"/>
                                            <TextBox Text="{Binding TrainingScheduleText, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource DarkTextBox}"
                                                     Width="135"
                                                     Height="30"
                                                     ToolTip="yyyy-MM-dd HH:mm"/>
                                            <Button Content="예약 적용"
                                                    Style="{StaticResource NavButton}"
                                                    Width="92"
                                                    Height="30"
                                                    Margin="8,0,18,0"
                                                    Command="{Binding ApplyImageTrainingScheduleCommand}"/>
                                            <CheckBox Content="매일 학습"
                                                      IsChecked="{Binding IsDailyTrainingEnabled, Mode=TwoWay}"
                                                      Foreground="#DDE7EF"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0"/>
                                            <TextBox Text="{Binding DailyTrainingTimeText, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource DarkTextBox}"
                                                     Width="70"
                                                     Height="30"
                                                     ToolTip="HH:mm"/>
                                            <Button Content="매일 적용"
                                                    Style="{StaticResource NavButton}"
                                                    Width="92"
                                                    Height="30"
                                                    Margin="8,0,12,0"
                                                    Command="{Binding ApplyDailyImageTrainingScheduleCommand}"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding TrainingStatusMessage}"
                                                   Foreground="#F3D36B"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="92"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="92"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="현재 상태" Foreground="#9FB3C8"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TrainingCurrentStatus}" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="진행률" Foreground="#9FB3C8"/>
                                            <Grid Grid.Row="0" Grid.Column="3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="52"/>
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Grid.Column="0" Height="18" Minimum="0" Maximum="100" Value="{Binding TrainingProgress, Mode=OneWay}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TrainingProgressText}" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="현재 메시지" Foreground="#9FB3C8" Margin="0,5,0,0"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding TrainingCurrentMessage}" Foreground="#DDE7EF" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="오류" Foreground="#9FB3C8" Margin="0,5,0,0"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TrainingErrorCode}" Foreground="#FF8A80" Margin="0,5,0,0"/>
                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="오류 메시지" Foreground="#9FB3C8" Margin="0,5,0,0"/>
                                            <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding TrainingErrorMessage}" Foreground="#FF8A80" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="시작/종료" Foreground="#9FB3C8" Margin="0,5,0,0"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding TrainingTimeSummary}" Foreground="#DDE7EF" Margin="0,5,0,0"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="학습 프로그램에서 받은 정보" Style="{StaticResource SectionTitle}"/>
                                            <Button Grid.Column="1"
                                                    Content="Grid 지우기"
                                                    Style="{StaticResource NavButton}"
                                                    Width="100"
                                                    Height="28"
                                                    Command="{Binding ClearTrainingProcessMessagesCommand}"/>
                                        </Grid>
                                        <DataGrid ItemsSource="{Binding TrainingProcessMessages}"
                                                  IsReadOnly="True"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  MaxHeight="360"
                                                  Margin="0,0,0,14"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="시간" Binding="{Binding Time}" Width="105"/>
                                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="90"/>
                                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110"/>
                                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="90"/>
                                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="300"/>
                                                <DataGridTextColumn Header="Raw" Binding="{Binding Raw}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </TabItem>
                    </TabControl>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
