                                                        <DataGridTextColumn Header="위치" Binding="{Binding ViewType}" Width="70"/>
                                                        <DataGridTextColumn Header="등록시간" Binding="{Binding RegisteredAt}" Width="132"/>
                                                        <!--
                                                            관리경로는 내용만큼 넓히고(Auto) 넘치는 만큼 가로로 넘겨 봅니다.
                                                            예전에는 Width="*" 였는데, 그러면 열이 남는 폭에 맞춰지기만 하고
                                                            긴 경로는 잘립니다. 표 전체 폭이 칸을 넘지 않으니 가로 스크롤바도
                                                            나오지 않았습니다. 칸에 마우스를 올리면 전체 경로가 뜹니다.
                                                        -->
                                                        <DataGridTextColumn Header="관리경로" Binding="{Binding DisplayPath}" Width="Auto" MinWidth="620">
                                                            <DataGridTextColumn.ElementStyle>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="ToolTip" Value="{Binding DisplayPath}"/>
                                                                </Style>
                                                            </DataGridTextColumn.ElementStyle>
                                                        </DataGridTextColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Row="2" Style="{StaticResource PanelBorder}">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                                    <WrapPanel>
                                                        <TextBlock Text="측정부" Style="{StaticResource SectionTitle}" Width="82"/>

                                                        <!-- 측정부는 카메라마다 따로 관리합니다. 고른 카메라의 것만 아래 목록에 나옵니다. -->
                                                        <ComboBox ItemsSource="{Binding MeasurementViewTypes}"
                                                                  SelectedItem="{Binding SelectedMeasurementViewType, Mode=TwoWay}"
                                                                  Width="110"
                                                                  Height="28"
                                                                  Margin="6,0,0,0"
                                                                  VerticalContentAlignment="Center"/>
                                                        <TextBlock Text="{Binding MeasurementPointCountText}"
                                                                   Foreground="#5BE37D"
                                                                   FontWeight="Bold"
                                                                   VerticalAlignment="Center"
                                                                   Margin="8,0,0,0"/>

                                                        <Button Content="추가" Width="54" Height="28" Margin="6,0,0,0" Style="{StaticResource NavButton}" Command="{Binding AddMeasurementPointCommand}"/>
                                                        <Button Content="삭제" Width="54" Height="28" Margin="6,0,0,0" Style="{StaticResource DangerButton}" Command="{Binding RemoveMeasurementPointCommand}"/>
                                                    </WrapPanel>
                                                    <TextBlock Text="(측정부 위치 표시는 해당 카메라의 기준 이미지가 있어야 가능합니다. 카메라마다 최대 5개)"
                                                               Foreground="#B8C7D4"
                                                               Margin="0,4,0,0"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <!-- 측정부는 "측정부 추가" 단추로만 늘립니다. 표에서 빈 행이 생기면
                                                     카메라가 정해지지 않은 측정부가 만들어집니다. -->
                                                <DataGrid ItemsSource="{Binding VisibleMeasurementPoints}"
                                                          SelectedItem="{Binding SelectedRegistrationMeasurementPoint, Mode=TwoWay}"
                                                          IsReadOnly="False"
                                                          CanUserAddRows="False"
                                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                          RowHeight="30">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="측정부" Binding="{Binding PointName}" Width="78" IsReadOnly="True"/>
                                                        <DataGridTextColumn Header="기준값" Binding="{Binding NominalValue, UpdateSourceTrigger=PropertyChanged}" Width="68"/>
                                                        <DataGridTextColumn Header="Min" Binding="{Binding ToleranceMin, UpdateSourceTrigger=PropertyChanged}" Width="56"/>
                                                        <DataGridTextColumn Header="Max" Binding="{Binding ToleranceMax, UpdateSourceTrigger=PropertyChanged}" Width="56"/>
                                                        <DataGridTemplateColumn Header="항목" Width="82">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <ComboBox ItemsSource="{Binding DataContext.MeasurementItemTypes, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                              SelectedItem="{Binding ItemType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                              Height="24"/>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTemplateColumn Header="위치표시" Width="76">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <Button Content="위치 표시"
                                                                            Height="24"
                                                                            Command="{Binding DataContext.EditMeasurementPositionCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                            CommandParameter="{Binding}"/>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTextColumn Header="X1" Binding="{Binding X1, StringFormat=0.###}" Width="58" IsReadOnly="True"/>
                                                        <DataGridTextColumn Header="Y1" Binding="{Binding Y1, StringFormat=0.###}" Width="58" IsReadOnly="True"/>
                                                        <DataGridTextColumn Header="X2" Binding="{Binding X2, StringFormat=0.###}" Width="58" IsReadOnly="True"/>
                                                        <DataGridTextColumn Header="Y2" Binding="{Binding Y2, StringFormat=0.###}" Width="58" IsReadOnly="True"/>
                                                        <DataGridTextColumn Header="색상" Binding="{Binding LineColor}" Width="76" IsReadOnly="True"/>
                                                        <DataGridTextColumn Header="단위" Binding="{Binding Unit}" Width="48" IsReadOnly="True"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </DockPanel>
                                        </Border>
                                    </Grid>
                                    <Border Grid.Column="4" Background="#101A22" BorderBrush="#33495B" BorderThickness="1" Padding="4">
                                        <ItemsControl ItemsSource="{Binding RegistrationImagePreviews}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="3" Rows="2"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="4" Background="#0C151C" BorderBrush="#263D4E" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="26"/>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="92"/>
                                                            </Grid.RowDefinitions>
                                                            <Border Background="#162331">
                                                                <TextBlock Text="{Binding Title}"
                                                                           Foreground="White"
                                                                           FontWeight="Bold"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                            <!-- 파일은 원본이지만 보여 줄 때는 제품만 잘라 크게 봅니다. -->
                                                            <Image Grid.Row="1"
                                                                   Source="{Binding PreviewSource}"
                                                                   Stretch="Uniform"
                                                                   Margin="4"/>
                                                            <TextBlock Grid.Row="1"
                                                                       Text="이미지 없음"
                                                                       Foreground="#8194A2"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <Border Grid.Row="2"
                                                                    Background="#101A22"
                                                                    BorderBrush="#263D4E"
                                                                    BorderThickness="0,1,0,0"
                                                                    Padding="3">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="20"/>
                                                                        <RowDefinition Height="*"/>
                                                                    </Grid.RowDefinitions>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="28"/>
                                                                            <ColumnDefinition Width="72"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="50"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="순위" Foreground="#8FA4B5" FontSize="9" HorizontalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="1" Text="품번" Foreground="#8FA4B5" FontSize="9" HorizontalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="2" Text="품명" Foreground="#8FA4B5" FontSize="9" HorizontalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="3" Text="유사도" Foreground="#8FA4B5" FontSize="9" HorizontalAlignment="Center"/>
                                                                    </Grid>
                                                                    <ItemsControl Grid.Row="1"
                                                                                  ItemsSource="{Binding SimilarityCandidates}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Grid Height="21">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="28"/>
                                                                                        <ColumnDefinition Width="72"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="50"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Text="{Binding Rank}"
                                                                                               Foreground="White"
                                                                                               FontSize="10"
                                                                                               HorizontalAlignment="Center"
                                                                                               VerticalAlignment="Center"/>
                                                                                    <TextBlock Grid.Column="1"
                                                                                               Text="{Binding PartNo}"
                                                                                               ToolTip="{Binding PartNo}"
                                                                                               Foreground="White"
                                                                                               FontSize="10"
                                                                                               TextTrimming="CharacterEllipsis"
                                                                                               VerticalAlignment="Center"/>
                                                                                    <TextBlock Grid.Column="2"
                                                                                               Text="{Binding PartName}"
                                                                                               ToolTip="{Binding PartName}"
                                                                                               Foreground="White"
                                                                                               FontSize="10"
                                                                                               TextTrimming="CharacterEllipsis"
                                                                                               VerticalAlignment="Center"/>
                                                                                    <TextBlock Grid.Column="3"
                                                                                               Text="{Binding Score, StringFormat=0.00}"
                                                                                               Foreground="LightGreen"
                                                                                               FontSize="10"
                                                                                               HorizontalAlignment="Right"
                                                                                               VerticalAlignment="Center"/>
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                    <TextBlock Grid.Row="1"
                                                                               Text="{Binding SimilarityStatusText}"
                                                                               Foreground="#8194A2"
                                                                               FontSize="10"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasSimilarityCandidates}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Grid>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="다중품목 등록">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Style="{StaticResource PanelBorder}">
                                    <StackPanel>
                                        <TextBlock Text="다중품목 CSV 등록" Style="{StaticResource SectionTitle}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="CSV 불러오기" Style="{StaticResource NavButton}" Width="120" Height="28" Command="{Binding ImportPartsCsvCommand}"/>
                                            <Button Content="전체 항목 CSV 내보내기" Style="{StaticResource NavButton}" Width="170" Height="28" Margin="8,0,0,8" Command="{Binding ExportAllPartsCsvCommand}"/>
                                            <Button Content="DB 저장" Style="{StaticResource NavButton}" Width="90" Height="28" Margin="8,0,0,8" Command="{Binding SaveBulkPartsCommand}"/>
                                            <TextBlock Text="{Binding BulkRegistrationMessage}" Foreground="#F3D36B" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="CSV 컬럼: 품번, 품명, 분류코드, 분류설명, 메모, Top1~5 및 Thk1~5의 항목/기준/Min/Max/색상/X1/Y1/X2/Y2, 단위(mm) · 예전 측정부1~5 열도 그대로 읽힙니다" Foreground="#B8C7D4" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Style="{StaticResource PanelBorder}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="CSV 처리 결과" Style="{StaticResource SectionTitle}"/>
                                        <DataGrid ItemsSource="{Binding BulkPartRows}" IsReadOnly="True" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="품번" Binding="{Binding PartNo}" Width="130"/>
                                                <DataGridTextColumn Header="품명" Binding="{Binding PartName}" Width="160"/>
                                                <DataGridTextColumn Header="분류코드" Binding="{Binding CategoryCode}" Width="100"/>
                                                <DataGridTextColumn Header="분류설명" Binding="{Binding CategoryDescription}" Width="180"/>
                                                <DataGridTextColumn Header="메모" Binding="{Binding Memo}" Width="90"/>
                                                <!-- 측정부는 카메라마다 다섯 개씩 따로 봅니다.
                                                     한데 묶어 다섯 칸만 두면 Top 이 다 차지해 Thickness 가 안 보입니다. -->
                                                <DataGridTextColumn Header="Top 1" Binding="{Binding Top1Summary}" Width="170"/>
                                                <DataGridTextColumn Header="Top 2" Binding="{Binding Top2Summary}" Width="170"/>
                                                <DataGridTextColumn Header="Top 3" Binding="{Binding Top3Summary}" Width="170"/>
                                                <DataGridTextColumn Header="Top 4" Binding="{Binding Top4Summary}" Width="170"/>
                                                <DataGridTextColumn Header="Top 5" Binding="{Binding Top5Summary}" Width="170"/>
                                                <DataGridTextColumn Header="Thk 1" Binding="{Binding Thk1Summary}" Width="170"/>
                                                <DataGridTextColumn Header="Thk 2" Binding="{Binding Thk2Summary}" Width="170"/>
                                                <DataGridTextColumn Header="Thk 3" Binding="{Binding Thk3Summary}" Width="170"/>
                                                <DataGridTextColumn Header="Thk 4" Binding="{Binding Thk4Summary}" Width="170"/>
                                                <DataGridTextColumn Header="Thk 5" Binding="{Binding Thk5Summary}" Width="170"/>
                                                <DataGridTextColumn Header="단위" Binding="{Binding MeasurementUnit}" Width="55"/>
                                                <DataGridTextColumn Header="처리결과" Binding="{Binding ResultMessage}" Width="220"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </TabItem>
                <TabItem Header="이력">
                    <Border Margin="12" Style="{StaticResource PanelBorder}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="검사 이력" Style="{StaticResource SectionTitle}" Width="110"/>
                                <Button Content="CSV 저장" Style="{StaticResource NavButton}" Width="90" Height="28" Command="{Binding SaveHistoryCsvCommand}"/>
                                <Button Content="검색 초기화" Style="{StaticResource NavButton}" Width="90" Height="28" Margin="6,0,0,8" Command="{Binding ClearHistorySearchCommand}"/>
                                <TextBlock Text="{Binding HistoryMessage}" Foreground="#F3D36B" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="135"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="135"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="135"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="135"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- 눌러서 기간을 채웁니다. Start는 어제, End는 오늘입니다. -->
                                <Button Content="Start" Style="{StaticResource NavButton}" Height="24" Margin="0,0,6,0" ToolTip="어제 이 시각을 넣습니다" Command="{Binding SetHistoryStartDateCommand}"/>
                                <TextBox Grid.Column="1" Text="{Binding HistoryStartTimeKeyword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                                <Button Grid.Column="2" Content="End" Style="{StaticResource NavButton}" Height="24" Margin="10,0,6,0" ToolTip="오늘 이 시각을 넣습니다" Command="{Binding SetHistoryEndDateCommand}"/>
                                <TextBox Grid.Column="3" Text="{Binding HistoryEndTimeKeyword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                                <TextBlock Grid.Column="4" Text="품번" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <TextBox Grid.Column="5" Text="{Binding HistoryPartNoKeyword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                                <TextBlock Grid.Column="6" Text="품명" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <TextBox Grid.Column="7" Text="{Binding HistoryPartNameKeyword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                                <TextBlock Grid.Row="1" Text="분류코드" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,6,0,0"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding HistoryCategoryCodeKeyword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="분류설명" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="10,6,0,0"/>
                                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding HistoryCategoryDescriptionKeyword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="4" Text="메모" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="10,6,0,0"/>
                                <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding HistoryMemoKeyword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="6" Text="NG결과" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="10,6,0,0"/>
                                <TextBox Grid.Row="1" Grid.Column="7" Text="{Binding HistoryNgResultKeyword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,6,0,0"/>
                            </Grid>
                            <DataGrid ItemsSource="{Binding InspectionHistory}"
                                      IsReadOnly="True"
                                      CanUserResizeColumns="True"
                                      SelectionUnit="Cell"
                                      PreviewKeyDown="OnSingleCellDataGridPreviewKeyDown"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="시간" Binding="{Binding InspectedAt}" Width="160"/>
                                    <DataGridTextColumn Header="품번" Binding="{Binding PartNo}" Width="120"/>
                                    <DataGridTextColumn Header="품명" Binding="{Binding PartName}" Width="150"/>
                                    <DataGridTextColumn Header="분류코드" Binding="{Binding CategoryCode}" Width="90"/>
                                    <DataGridTextColumn Header="분류설명" Binding="{Binding CategoryDescription}" Width="160"/>
                                    <DataGridTextColumn Header="메모" Binding="{Binding Memo}" Width="90"/>
                                    <DataGridTextColumn Header="결과" Binding="{Binding Result}" Width="70"/>
                                    <DataGridTextColumn Header="NG결과" Binding="{Binding NgResult}" Width="180"/>
                                    <DataGridTextColumn Header="측정값" Binding="{Binding MeasuredValues}" Width="160"/>
                                    <DataGridTextColumn Header="기준값" Binding="{Binding NominalValues}" Width="160"/>
                                    <DataGridTextColumn Header="메시지" Binding="{Binding Message}" Width="360"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </TabItem>
                <TabItem Header="통계">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- 눌러서 기간을 채웁니다. Start는 어제, End는 오늘입니다. -->
                            <Button Content="Start"
                                    Style="{StaticResource NavButton}"
                                    Width="60"
                                    Height="28"
                                    Margin="0,0,8,0"
                                    ToolTip="어제 이 시각을 넣습니다"
                                    Command="{Binding SetStatisticsStartDateCommand}"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding StatisticsStartTimeKeyword, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBox}"
                                     Height="28"/>
                            <Button Grid.Column="2"
                                    Content="End"
                                    Style="{StaticResource NavButton}"
                                    Width="60"
                                    Height="28"
                                    Margin="12,0,8,0"
                                    ToolTip="오늘 이 시각을 넣습니다"
                                    Command="{Binding SetStatisticsEndDateCommand}"/>
                            <TextBox Grid.Column="3"
                                     Text="{Binding StatisticsEndTimeKeyword, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBox}"
                                     Height="28"/>
                            <Button Grid.Column="4"
                                    Content="통계 조회"
                                    Style="{StaticResource NavButton}"
                                    Width="100"
                                    Height="28"
                                    Margin="12,0,0,0"
                                    Command="{Binding RefreshStatisticsCommand}"/>
                            <Button Grid.Column="5"
                                    Content="초기화"
                                    Style="{StaticResource NavButton}"
                                    Width="82"
                                    Height="28"
                                    Margin="8,0,0,0"
                                    Command="{Binding ResetStatisticsCommand}"/>
                            <TextBlock Grid.Column="6"
                                       Text="{Binding StatisticsMessage}"
                                       Foreground="#F3D36B"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="12,0,0,0"/>
                        </Grid>
                        <UniformGrid Grid.Row="1" Columns="5" Rows="1" Height="68" Margin="0,8,0,0">
                            <Border Style="{StaticResource PanelBorder}" Margin="4" Padding="8,5">
                                <StackPanel>
                                    <TextBlock Text="총 등록 부품수" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding TotalPartCount}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorder}" Margin="4" Padding="8,5">
                                <StackPanel>
                                    <TextBlock Text="검사실적" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding TotalInspectionCount}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorder}" Margin="4" Padding="8,5">
                                <StackPanel>
                                    <TextBlock Text="PASS 수" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding PassCount}" Foreground="#5BE37D" FontSize="22" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorder}" Margin="4" Padding="8,5">
                                <StackPanel>
                                    <TextBlock Text="FAIL 수" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding FailCount}" Foreground="#FF7878" FontSize="22" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorder}" Margin="4" Padding="8,5">
                                <StackPanel>
                                    <TextBlock Text="오류 수" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding ErrorCount}" Foreground="#F3D36B" FontSize="22" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Margin="0,8,0,0" Padding="8">
