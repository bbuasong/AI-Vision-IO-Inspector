<Window x:Class="AI.Vision.IOInspector.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AI.Vision.IOInspector.App.Controls"
        xmlns:converters="clr-namespace:AI.Vision.IOInspector.App.Converters"
        Title="HD현대사이트솔루션 AI-Vision IO Inspector" Height="840" Width="1440"
        MinHeight="780" MinWidth="1240" WindowStartupLocation="CenterScreen"
        Background="#0B141B" FontFamily="Malgun Gothic">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:ImageFilePathConverter x:Key="ImageFilePathConverter"/>
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="#1D2A36"/>
            <Setter Property="BorderBrush" Value="#33495B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="#0A86D8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0A86D8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Background" Value="#9B2D2D"/>
            <Setter Property="BorderBrush" Value="#9B2D2D"/>
        </Style>
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="#F7F9FB"/>
            <Setter Property="BorderBrush" Value="#9AA8B5"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDE7EF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="InfoLabelCell" TargetType="Border">
            <Setter Property="Background" Value="#0E1A23"/>
            <Setter Property="BorderBrush" Value="#4B6070"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style x:Key="InfoValueCell" TargetType="Border">
            <Setter Property="Background" Value="#EDF3F7"/>
            <Setter Property="BorderBrush" Value="#4B6070"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style x:Key="ReadOnlyInfoTextBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="#0B141B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="30"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style x:Key="MainTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid Background="{TemplateBinding Background}" KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel x:Name="HeaderPanel"
                                      Grid.Row="0"
                                      Panel.ZIndex="1"
                                      IsItemsHost="True"
                                      KeyboardNavigation.TabIndex="1"
                                      Background="Transparent"/>
                            <Grid Grid.Row="1">
                                <!--
                                    검사 탭은 TabItem.Content를 비워 두고, 6개 카메라 화면(RtspVideoHost)은
                                    TabControl 콘텐츠 영역과 같은 셀에 항상 붙어있는 오버레이로 배치합니다.
                                    다른 탭으로 전환해도 이 Grid는 시각 트리에서 탈부착되지 않고 Visibility만
                                    바뀌므로 RtspVideoHost가 Unloaded 되지 않고(LibVLC 세션 유지) 계속 스트리밍합니다.
                                -->
                                <Grid Margin="12"
                                      Visibility="{Binding IsInspectionTabActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Style="{StaticResource PanelBorder}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Content="기준 이미지 저장" Style="{StaticResource NavButton}" Margin="0" Command="{Binding SaveCurrentCameraImagesCommand}" CommandParameter="Inspection"/>
                                            <Button Grid.Column="1" Content="검사 시작" Style="{StaticResource NavButton}" Margin="10,0,0,0" Command="{Binding RunInspectionCommand}"/>
                                            <Button Grid.Column="2" Content="화면 초기화" Style="{StaticResource NavButton}" Margin="10,0,0,0" Command="{Binding ResetInspectionScreenCommand}"/>
                                            <StackPanel Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="상태: " Foreground="#B8C7D4" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="Bold"/>
                                                </StackPanel>
                                                <DockPanel Margin="0,4,0,0">
                                                    <TextBlock DockPanel.Dock="Left" Text="결과: " Foreground="#B8C7D4" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding ResultText}" Foreground="#5BE37D" FontWeight="Bold" TextWrapping="Wrap"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding ImageSlots}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3" Rows="2"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!--
                                                    기준 이미지 확대 팝업은 좌측 상단 "기준 이미지" 칸을 클릭할 때만 엽니다.
                                                    예전에는 이 Border 전체에 MouseBinding이 걸려 있어 카메라 화면 아무 곳이나
                                                    두 번 클릭해도 팝업이 떴습니다.
                                                -->
                                                <Border Margin="4" Background="#0A1016" BorderBrush="{Binding ResultBorderBrush}" BorderThickness="{Binding ResultBorderThickness}" CornerRadius="4">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="32"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <Border Background="#101820">
                                                            <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Grid Grid.Row="1"
                                                              Background="#0A1016"
                                                              ClipToBounds="True"
                                                              Visibility="{Binding IsLiveInspectionViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="CAMERA" FontSize="24" FontWeight="SemiBold" Foreground="#7B8790" HorizontalAlignment="Center"/>
                                                                <TextBlock Text="{Binding StatusText}" Foreground="#45515A" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                            </StackPanel>
                                                            <controls:RtspVideoHost StreamUrl="{Binding LiveStreamUrl}"
                                                                                    IsStreaming="{Binding IsLiveStreamEnabled}"
                                                                                    FrameWidth="{Binding FrameWidth}"
                                                                                    FrameHeight="{Binding FrameHeight}"
                                                                                    ReferenceImagePath="{Binding ReferenceImagePath}"
                                                                                    ReferenceImageClick="OnReferenceImageOverlayClick"
                                                                                    Visibility="{Binding IsNativeStreamVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            <!-- RTSP 콜백으로 받은 프레임을 직접 그리는 화면입니다.
                                                                 CFG의 UseCallbackVideoRendering을 켜면 위의 LibVLC 영상 창 대신 이쪽이 나옵니다.
                                                                 평범한 Image라 위에 다른 요소를 겹쳐 놓을 수 있습니다. -->
                                                            <controls:CallbackVideoView MonitorIndex="{Binding MonitorIndex}"
                                                                                        IsStreaming="{Binding IsCallbackStreamVisible}"
                                                                                        UseCrop="{Binding UseVideoCrop}"
                                                                                        CropIntervalMilliseconds="{Binding VideoCropIntervalMilliseconds}"
                                                                                        HasLiveFrame="{Binding IsLiveFrameArrived, Mode=OneWayToSource}"
                                                                                        Visibility="{Binding IsCallbackStreamVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            <!--
                                                                기준 이미지를 왼쪽 위에 작게 겹쳐 보여 줍니다.
                                                                LibVLC 영상 창에는 이 겹치기가 창 안에 들어 있었는데,
                                                                콜백 화면으로 바꾸면서 함께 사라졌습니다. 여기서 다시 얹습니다.
                                                                누르면 기준 이미지 확대 창이 열립니다.
                                                            -->
                                                            <Border HorizontalAlignment="Left"
                                                                    VerticalAlignment="Top"
                                                                    Margin="6"
                                                                    BorderBrush="#33495B"
                                                                    BorderThickness="1"
                                                                    Background="#0A1016"
                                                                    Panel.ZIndex="3"
                                                                    Cursor="Hand"
                                                                    MouseLeftButtonUp="OnReferenceImageOverlayClick"
                                                                    Visibility="{Binding IsCallbackStreamVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <Image Source="{Binding ReferenceImagePath, Converter={StaticResource ImageFilePathConverter}}"
                                                                       Stretch="Uniform"
                                                                       MaxWidth="150"
                                                                       MaxHeight="110"/>
                                                            </Border>
                                                            <Image Source="{Binding LiveImageSource}"
                                                                   Stretch="Uniform"
                                                                   Visibility="{Binding IsCapturedStillVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            <Border HorizontalAlignment="Left"
                                                                    VerticalAlignment="Bottom"
                                                                    Margin="8"
                                                                    Background="#D90E1A23"
                                                                    CornerRadius="3"
                                                                    Padding="8,3"
                                                                    IsHitTestVisible="False"
                                                                    Panel.ZIndex="4">
                                                                <TextBlock Text="{Binding StatusText}"
                                                                           Foreground="White"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxWidth="330"/>
                                                            </Border>
                                                            <Border HorizontalAlignment="Left"
                                                                    VerticalAlignment="Top"
                                                                    Margin="8"
                                                                    Background="#B73535"
                                                                    CornerRadius="3"
                                                                    Padding="8,3"
                                                                    Opacity="0.92"
                                                                    Visibility="{Binding IsReferenceImageMissing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBlock Text="기준 이미지 없음" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                                            </Border>
                                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Background="{Binding ResultBrush}" CornerRadius="3" Padding="8,2" Opacity="0.96">
                                                                <TextBlock Text="{Binding ResultText}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                                            </Border>
                                                        </Grid>
                                                        <Grid Grid.Row="1"
                                                              Background="#0A1016"
                                                              Visibility="{Binding IsInspectionCompletedViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Grid>
                                                                <Image
                                                                       Source="{Binding LiveImageSource}"
                                                                       Stretch="Uniform"
                                                                       Margin="2"/>

                                                                <Grid Panel.ZIndex="2">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="1*"/>
                                                                        <RowDefinition Height="3*"/>
                                                                    </Grid.RowDefinitions>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="1*"/>
                                                                        <ColumnDefinition Width="2*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Row="0"
                                                                        Grid.Column="0"
                                                                        Margin="7"
                                                                        Background="#E80C151C"
                                                                        BorderBrush="#8DA9BB"
                                                                        BorderThickness="2"
                                                                        CornerRadius="3"
                                                                        Cursor="Hand"
                                                                        ToolTip="클릭하면 기준 이미지를 크게 봅니다.">
                                                                        <!-- 검사완료 화면에서도 기준 이미지 칸에서만 팝업을 엽니다. -->
                                                                        <Border.InputBindings>
                                                                            <MouseBinding MouseAction="LeftClick"
                                                                                          Command="{Binding DataContext.ShowReferenceImagePopupCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                                          CommandParameter="{Binding}"/>
                                                                        </Border.InputBindings>
                                                                        <Grid>
                                                                            <Image Source="{Binding ReferenceImagePath, Converter={StaticResource ImageFilePathConverter}}"
                                                                               Stretch="Uniform"
                                                                               Margin="2"/>
                                                                            <Border HorizontalAlignment="Left"
                                                                                VerticalAlignment="Top"
                                                                                Background="#D90E1A23"
                                                                                Padding="6,2">
                                                                                <TextBlock Text="기준 이미지" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                                            </Border>
                                                                            <TextBlock Text="기준 이미지 없음"
                                                                                   Foreground="White"
                                                                                   FontSize="10"
                                                                                   FontWeight="Bold"
                                                                                   TextWrapping="Wrap"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"
                                                                                   Visibility="{Binding IsReferenceImageMissing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </Grid>

                                                                <StackPanel HorizontalAlignment="Right"
                                                                            VerticalAlignment="Top"
                                                                            Orientation="Horizontal"
                                                                            Margin="7"
                                                                            Panel.ZIndex="3">
                                                                    <Border Background="{Binding ScoreBrush}"
                                                                            CornerRadius="3"
                                                                            Padding="10,3"
                                                                            Margin="0,0,6,0">
                                                                        <TextBlock Text="{Binding ScoreText}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                                                    </Border>
                                                                    <Border Background="{Binding ResultBrush}"
                                                                            CornerRadius="3"
                                                                            Padding="10,3">
                                                                        <TextBlock Text="{Binding ResultText}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                                                    </Border>
                                                                </StackPanel>
                                                                <Border HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Background="#7A000000"
                                                                        CornerRadius="4"
                                                                        Padding="18,4"
                                                                        IsHitTestVisible="False"
                                                                        Panel.ZIndex="3">
                                                                    <TextBlock Text="{Binding ResultText}"
                                                                               Foreground="{Binding ResultBrush}"
                                                                               FontSize="30"
                                                                               FontWeight="Black">
                                                                        <TextBlock.Effect>
                                                                            <DropShadowEffect Color="White" Direction="315" ShadowDepth="1" BlurRadius="0"/>
                                                                        </TextBlock.Effect>
                                                                    </TextBlock>
                                                                </Border>
                                                                <Border HorizontalAlignment="Center"
                                                                        VerticalAlignment="Bottom"
                                                                        Background="#C90C151C"
                                                                        CornerRadius="3"
                                                                        Padding="10,3"
                                                                        Margin="0,0,0,7"
                                                                        IsHitTestVisible="False"
                                                                        Panel.ZIndex="3">
                                                                    <TextBlock Text="{Binding DimensionText}"
                                                                               Foreground="White"
                                                                               FontSize="12"
                                                                               FontWeight="SemiBold"/>
                                                                </Border>
                                                            </Grid>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                                <Border x:Name="ContentPanel"
                                        KeyboardNavigation.DirectionalNavigation="Contained"
                                        KeyboardNavigation.TabIndex="2"
                                        KeyboardNavigation.TabNavigation="Local">
                                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                                      ContentSource="SelectedContent"
                                                      Margin="{TemplateBinding Padding}"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MainTabItemStyle" TargetType="TabItem">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Foreground" Value="#C8D4DE"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="#172530"
                                BorderBrush="#33495B"
                                BorderThickness="1,1,1,0"
                                CornerRadius="4,4,0,0"
                                Padding="18,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#244154"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#0A86D8"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#45ADEC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SubTabItemStyle" TargetType="TabItem">
            <Setter Property="MinWidth" Value="118"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="#B8C7D4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="SubTabBorder"
                                Background="#14212B"
                                BorderBrush="#33495B"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="20,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SubTabBorder" Property="Background" Value="#203A4B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SubTabBorder" Property="Background" Value="#E8F2F8"/>
                                <Setter TargetName="SubTabBorder" Property="BorderBrush" Value="#7AA6BF"/>
                                <Setter Property="Foreground" Value="#10212C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#202C38" BorderBrush="#314353" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="150" Height="30" Background="#E8EEF3" CornerRadius="2" VerticalAlignment="Center" HorizontalAlignment="Left" Padding="6,3">
                    <Image Source="Assets/VLAD_Mon_Logo.png" Stretch="Uniform"/>
                </Border>
                <TextBlock Grid.Column="1" Text="현대  |  AI-Vision IO Inspector" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FFD400"
                            CornerRadius="3"
                            Padding="10,4"
                            Margin="0,0,12,0"
                            Visibility="{Binding IsImageTrainingRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Border.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.25" Duration="0:0:1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <TextBlock Text="학습중" Foreground="#1A1400" FontWeight="Bold" FontSize="12"/>
                    </Border>
                    <TextBlock Text="{Binding ApplicationVersionText}" Foreground="#B8C7D4" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource PanelBorder}" Grid.Row="0" Margin="0">
                    <StackPanel>
                        <TextBlock Text="SEARCH DB" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBox}"
                                     Height="32"
                                     VerticalAlignment="Top"
                                     ToolTip="품번, 품명, 분류코드, 분류설명, 메모 검색"/>
                            <Button Grid.Column="2"
                                    Style="{StaticResource NavButton}"
                                    Width="32"
                                    Height="32"
                                    VerticalAlignment="Top"
                                    Padding="0"
                                    ToolTip="Epson ES-C320W OCR 스캔 후 검색"
                                    Command="{Binding StartOcrScanCommand}">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE721;"
                                           FontSize="15"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding MainSearchSuggestions}" Margin="0,6,0,0"
                                      Visibility="{Binding HasMainSearchSuggestions, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}"
                                                    Command="{Binding DataContext.ApplyMainSearchSuggestionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    Margin="0,0,14,0"
                                                    Foreground="#5BE37D"
                                                    FontWeight="SemiBold"
                                                    Cursor="Hand"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PanelBorder}" Grid.Row="2" Margin="0">
                    <StackPanel>
