<Window x:Class="AI.Vision.IOInspector.App.ReferenceImagePopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="등록 기준 이미지 확대"
        Width="1080"
        Height="760"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#101A22">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#162331" BorderBrush="#33495B" BorderThickness="1" Padding="14">
            <StackPanel>
                <TextBlock Text="등록 기준 이미지" Foreground="White" FontSize="16" FontWeight="Bold"/>
                <TextBlock x:Name="PartInfoText" Foreground="#DDE7EF" TextWrapping="Wrap" Margin="0,16,0,0"/>
                <TextBlock Text="현재 위치" Foreground="#9FB3C8" Margin="0,20,0,0"/>
                <TextBlock x:Name="LocationText" Foreground="#5BE37D" FontWeight="Bold" FontSize="18" Margin="0,4,0,0"/>
                <TextBlock x:Name="PositionText" Foreground="#B8C7D4" Margin="0,4,0,0"/>
                <TextBlock Text="Search DB 품목이 바뀌면 이 창도 같은 품목의 이미지로 갱신됩니다."
                           Foreground="#9FB3C8"
                           TextWrapping="Wrap"
                           Margin="0,28,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.Column="2" Background="#05090C" BorderBrush="#33495B" BorderThickness="1" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="46"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Image x:Name="ReferenceImage" Stretch="Uniform" Margin="8"/>
                    <TextBlock x:Name="EmptyImageText"
                               Text="등록된 기준 이미지가 없습니다."
                               Foreground="#B8C7D4"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="이전" Width="90" Height="30" Click="OnPreviousClick"/>
                    <TextBlock Grid.Column="1" x:Name="ImageNameText" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="다음" Width="90" Height="30" Click="OnNextClick"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
