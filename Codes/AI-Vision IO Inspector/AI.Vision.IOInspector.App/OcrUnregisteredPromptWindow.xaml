<Window x:Class="AI.Vision.IOInspector.App.OcrUnregisteredPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OCR 부품 미등록"
        Width="440"
        Height="220"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#101A22"
        FontFamily="Malgun Gothic">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageTextBlock"
                   Foreground="#DDE7EF"
                   TextWrapping="Wrap"
                   FontSize="13"
                   VerticalAlignment="Center"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="등록진행"
                    Width="96"
                    Height="30"
                    Margin="0,0,8,0"
                    Click="OnProceedClick"/>
            <Button Content="취소"
                    Width="96"
                    Height="30"
                    Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</Window>
