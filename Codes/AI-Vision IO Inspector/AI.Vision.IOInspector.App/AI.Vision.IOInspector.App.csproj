<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <!-- EXE 파일과 창 제목 표시줄에 사용하는 프로그램 아이콘입니다.
         CFG\Icon\Icon.ico는 배포 시 실행 폴더로도 함께 복사됩니다(RuntimeConfigFile). -->
    <ApplicationIcon>..\CFG\Icon\Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\Logo.png" />
    <None Remove="Assets\VLAD_Mon_Logo.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AI.Vision.IOInspector.Domain\AI.Vision.IOInspector.Domain.csproj" />
    <ProjectReference Include="..\AI.Vision.IOInspector.Application\AI.Vision.IOInspector.Application.csproj" />
    <ProjectReference Include="..\AI.Vision.IOInspector.Infrastructure\AI.Vision.IOInspector.Infrastructure.csproj" />
    <ProjectReference Include="..\AI.Vision.IOInspector.Vision\AI.Vision.IOInspector.Vision.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\VLAD_Mon_Logo.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- 실행 폴더만 배포해도 동작하도록 실제 프로젝트 루트의 런타임 폴더를 출력 폴더에 같은 구조로 복사합니다.
         Visual Studio 프로젝트 트리에는 보이지 않도록 Content 대신 전용 MSBuild Item을 사용합니다. -->
    <RuntimeConfigFile Include="..\CFG\**\*" />
    <RuntimeNativeVladFile Include="..\Native\VLAD\**\*" Exclude="..\Native\VLAD\CFG\**\*;..\Native\VLAD\System.Buffers.dll;..\Native\VLAD\System.Memory.dll;..\Native\VLAD\System.Numerics.Vectors.dll;..\Native\VLAD\System.Runtime.CompilerServices.Unsafe.dll" />
    <RuntimeNativeEpsonOcrFile Include="..\Native\EpsonOCR\**\*" />
    <RuntimeDatabaseFile Include="..\DB\DataBase.db" />
    <RuntimeReferenceImageFile Include="..\DB\Image\**\*" />
    <RuntimeModelFile Include="..\RuntimeData\Models\**\*" />
    <!-- RTSP 프레임 캡처는 ffmpeg를 1차 경로로 쓰고 LibVLC/OpenCvSharp을 대체 경로로 씁니다(FfmpegToolLocator).
         ffmpeg.exe가 없으면 항상 LibVLC로만 캡처하게 되어, 특정 채널에서 재생/스냅샷이 불안정한 경우
         구제할 방법이 없습니다. 빌드마다 항상 같이 배포되도록 합니다. -->
    <RuntimeNativeFfmpegFile Include="..\RuntimeData\Native\FFmpeg\**\*" />
    <!-- MobileSAM 모델입니다. 실행 파일과 같은 폴더에서 찾는 경로와 Native\VLAD 에서 찾는 경로가
         모두 있어 양쪽에 둡니다.

         원본을 솔루션 폴더에 두고 저장소에 함께 담습니다. Native\ 는 .gitignore로 제외되어 있어
         그쪽을 원본으로 삼으면 저장소를 새로 받은 PC에서 파일이 없어 빌드가 되지 않습니다. -->
    <RuntimeSamModelFile Include="..\mobile_sam.onnx;..\mobile_sam_decoder.onnx;..\mobile_sam_encoder.onnx" />
  </ItemGroup>

  <Target Name="CopyAppRuntimeFoldersToOutput" AfterTargets="Build">
    <MakeDir Directories="$(OutDir)CFG;$(OutDir)DB;$(OutDir)DB\Image;$(OutDir)DB\Inspection_Data;$(OutDir)DB\Logs;$(OutDir)Native\VLAD;$(OutDir)Native\EpsonOCR;$(OutDir)RuntimeData\Models;$(OutDir)RuntimeData\Native\FFmpeg" />
    <Copy SourceFiles="@(RuntimeConfigFile)" DestinationFiles="@(RuntimeConfigFile->'$(OutDir)CFG\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RuntimeNativeVladFile)" DestinationFiles="@(RuntimeNativeVladFile->'$(OutDir)Native\VLAD\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RuntimeNativeEpsonOcrFile)" DestinationFiles="@(RuntimeNativeEpsonOcrFile->'$(OutDir)Native\EpsonOCR\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RuntimeDatabaseFile)" DestinationFiles="@(RuntimeDatabaseFile->'$(OutDir)DB\%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RuntimeReferenceImageFile)" DestinationFiles="@(RuntimeReferenceImageFile->'$(OutDir)DB\Image\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RuntimeModelFile)" DestinationFiles="@(RuntimeModelFile->'$(OutDir)RuntimeData\Models\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RuntimeNativeFfmpegFile)" DestinationFiles="@(RuntimeNativeFfmpegFile->'$(OutDir)RuntimeData\Native\FFmpeg\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RuntimeSamModelFile)" DestinationFiles="@(RuntimeSamModelFile->'$(OutDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RuntimeSamModelFile)" DestinationFiles="@(RuntimeSamModelFile->'$(OutDir)Native\VLAD\%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Platform을 명시하지 않고 빌드하면(dotnet build 등) MSBuild가 AnyCPU로 취급해
         bin\Debug\ 폴더에 결과물이 생겨, Visual Studio가 빌드하는 bin\x64\Debug\와
         산출물이 갈라집니다. 항상 x64로 고정해 출력 경로를 하나로 통일합니다. -->
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == '' OR '$(Platform)' == 'AnyCPU'">x64</Platform>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>False</AllowUnsafeBlocks>
    <UseWindowsForms>True</UseWindowsForms>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Version>1.0.0.1</Version>
    <AssemblyVersion>1.0.0.1</AssemblyVersion>
    <FileVersion>1.0.0.1</FileVersion>
  </PropertyGroup>

</Project>
