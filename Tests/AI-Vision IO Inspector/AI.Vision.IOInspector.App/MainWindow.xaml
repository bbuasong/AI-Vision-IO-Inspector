                                <TextBlock Grid.Column="6" Text="품명" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <TextBox Grid.Column="7" Text="{Binding HistoryPartNameKeyword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                                <TextBlock Grid.Row="1" Text="분류코드" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,6,0,0"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding HistoryCategoryCodeKeyword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="분류설명" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="10,6,0,0"/>
                                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding HistoryCategoryDescriptionKeyword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="4" Text="구분" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="10,6,0,0"/>
                                <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding HistoryPartTypeKeyword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="6" Text="NG결과" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="10,6,0,0"/>
                                <TextBox Grid.Row="1" Grid.Column="7" Text="{Binding HistoryNgResultKeyword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,6,0,0"/>
                            </Grid>
                            <DataGrid ItemsSource="{Binding InspectionHistory}"
                                      IsReadOnly="True"
                                      CanUserResizeColumns="True"
                                      SelectionUnit="Cell"
                                      PreviewKeyDown="OnSingleCellDataGridPreviewKeyDown"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="시간" Binding="{Binding InspectedAt}" Width="160"/>
                                    <DataGridTextColumn Header="품번" Binding="{Binding PartNo}" Width="120"/>
                                    <DataGridTextColumn Header="품명" Binding="{Binding PartName}" Width="150"/>
                                    <DataGridTextColumn Header="분류코드" Binding="{Binding CategoryCode}" Width="90"/>
                                    <DataGridTextColumn Header="분류설명" Binding="{Binding CategoryDescription}" Width="160"/>
                                    <DataGridTextColumn Header="구분" Binding="{Binding PartType}" Width="90"/>
                                    <DataGridTextColumn Header="결과" Binding="{Binding Result}" Width="70"/>
                                    <DataGridTextColumn Header="NG결과" Binding="{Binding NgResult}" Width="180"/>
                                    <DataGridTextColumn Header="측정값" Binding="{Binding MeasuredValues}" Width="160"/>
                                    <DataGridTextColumn Header="기준값" Binding="{Binding NominalValues}" Width="160"/>
                                    <DataGridTextColumn Header="메시지" Binding="{Binding Message}" Width="360"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </TabItem>
                <TabItem Header="통계">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Content="통계 새로고침" Style="{StaticResource NavButton}" Width="150" HorizontalAlignment="Left" Command="{Binding RefreshStatisticsCommand}"/>
                        <UniformGrid Grid.Row="1" Columns="3" Rows="2" Margin="0,12,0,0">
                            <Border Style="{StaticResource PanelBorder}" Margin="6">
                                <StackPanel>
                                    <TextBlock Text="총 등록 부품수" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding TotalPartCount}" Foreground="White" FontSize="32" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorder}" Margin="6">
                                <StackPanel>
                                    <TextBlock Text="검사실적" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding TotalInspectionCount}" Foreground="White" FontSize="32" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorder}" Margin="6">
                                <StackPanel>
                                    <TextBlock Text="OK 수" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding OkCount}" Foreground="#5BE37D" FontSize="32" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorder}" Margin="6">
                                <StackPanel>
                                    <TextBlock Text="NG 수" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding NgCount}" Foreground="#FF7878" FontSize="32" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorder}" Margin="6">
                                <StackPanel>
                                    <TextBlock Text="오류 수" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding ErrorCount}" Foreground="#F3D36B" FontSize="32" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelBorder}" Margin="6">
                                <StackPanel>
                                    <TextBlock Text="평균 검사시간" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding AverageInspectionTime}" Foreground="White" FontSize="32" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </TabItem>
                <TabItem Header="옵션">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="195*"/>
                            <ColumnDefinition Width="367*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource PanelBorder}" Grid.ColumnSpan="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="상태 새로고침" Style="{StaticResource NavButton}" Width="120" Height="28" Margin="0" Command="{Binding RefreshCameraStatusCommand}"/>
                                    <Button Content="선택 연결테스트" Style="{StaticResource NavButton}" Width="130" Height="28" Margin="8,0,0,0" Command="{Binding TestSelectedCameraConnectionCommand}"/>
                                    <Button Content="설정 저장" Style="{StaticResource NavButton}" Width="100" Height="28" Margin="8,0,0,0" Command="{Binding SaveCameraConfigurationCommand}"/>
                                    <Button Content="설정 다시 읽기" Style="{StaticResource NavButton}" Width="120" Height="28" Margin="8,0,0,0" Command="{Binding ReloadCameraConfigurationCommand}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding CameraStatusMessage}" Foreground="#F3D36B" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Grid.ColumnSpan="2">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Config.json 카메라 설정/연결 상태" Style="{StaticResource SectionTitle}"/>
                                <DataGrid DockPanel.Dock="Top"
                                          ItemsSource="{Binding CameraChannels}"
                                          SelectedItem="{Binding SelectedCameraChannel}"
                                          IsReadOnly="False"
                                          MaxHeight="280"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="카메라" Binding="{Binding CameraKey}" Width="62" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="X" Binding="{Binding CamX}" Width="38"/>
                                        <DataGridTextColumn Header="Y" Binding="{Binding CamY}" Width="38"/>
                                        <DataGridTextColumn Header="형식" Binding="{Binding ConnectionType}" Width="62"/>
                                        <DataGridTextColumn Header="RTSP URL" Binding="{Binding RtspUrl, UpdateSourceTrigger=PropertyChanged}" Width="470"/>
                                        <DataGridTextColumn Header="상태" Binding="{Binding ConnectedText}" Width="58" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="메시지" Binding="{Binding Message}" Width="2*" MinWidth="420" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="확인시각" Binding="{Binding CheckedAt}" Width="150" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock DockPanel.Dock="Top" Text="HDD 사용량" Style="{StaticResource SectionTitle}" Margin="0,14,0,8"/>
                                <DataGrid DockPanel.Dock="Top"
                                          ItemsSource="{Binding DiskUsages}"
                                          IsReadOnly="True"
                                          MaxHeight="150"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="드라이브" Binding="{Binding DriveName}" Width="80"/>
                                        <DataGridTextColumn Header="이름" Binding="{Binding VolumeLabel}" Width="120"/>
                                        <DataGridTextColumn Header="전체" Binding="{Binding TotalText}" Width="100"/>
                                        <DataGridTextColumn Header="사용" Binding="{Binding UsedText}" Width="100"/>
                                        <DataGridTextColumn Header="여유" Binding="{Binding AvailableText}" Width="100"/>
                                        <DataGridTextColumn Header="사용률" Binding="{Binding UsagePercentText}" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Grid DockPanel.Dock="Top" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="검사 데이터 자동삭제"
                                               Style="{StaticResource SectionTitle}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>
                                    <CheckBox Grid.Column="1"
                                              Content="HDD 여유공간 기준"
                                              IsChecked="{Binding IsFreeSpaceAutoCleanupEnabled, Mode=TwoWay}"
                                              Foreground="#DDE7EF"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="2"
                                             Text="{Binding MinimumFreeSpacePercentText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DarkTextBox}"
                                             Height="28"/>
                                    <TextBlock Grid.Column="3"
                                               Text="% 이하"
                                               Foreground="#DDE7EF"
                                               VerticalAlignment="Center"
                                               Margin="6,0,14,0"/>
                                    <CheckBox Grid.Column="4"
                                              Content="설정기간 이후"
                                              IsChecked="{Binding IsRetentionPeriodCleanupEnabled, Mode=TwoWay}"
                                              Foreground="#DDE7EF"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"/>
                                    <ComboBox Grid.Column="5"
                                              ItemsSource="{Binding RetentionPeriodOptions}"
                                              Text="{Binding RetentionDaysText, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True"
                                              Height="28"/>
                                    <TextBlock Grid.Column="6"
                                               Text="일"
                                               Foreground="#DDE7EF"
                                               VerticalAlignment="Center"
                                               Margin="6,0,12,0"/>
                                    <Button Grid.Column="7"
                                            Content="저장"
                                            Style="{StaticResource NavButton}"
                                            Width="72"
                                            Height="28"
                                            Command="{Binding SaveRetentionSettingsCommand}"/>
                                    <TextBlock Grid.Column="8"
                                               Text="{Binding RetentionStatusMessage}"
                                               Foreground="#F3D36B"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Margin="12,0,0,0"/>
                                </Grid>
                                <Grid DockPanel.Dock="Top" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="자동기능"
                                               Style="{StaticResource SectionTitle}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>
                                    <Button Grid.Column="1"
                                            Content="학습 바로시작"
                                            Style="{StaticResource NavButton}"
                                            Width="120"
                                            Height="30"
                                            Margin="0,0,12,0"
                                            Command="{Binding StartImageTrainingCommand}"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox Content="예약설정"
                                                  IsChecked="{Binding IsTrainingReservationEnabled, Mode=TwoWay}"
                                                  Foreground="#DDE7EF"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"/>
                                        <TextBox Text="{Binding TrainingScheduleText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DarkTextBox}"
                                                 Width="135"
                                                 ToolTip="yyyy-MM-dd HH:mm"/>
                                    </StackPanel>
                                    <Button Grid.Column="3"
                                            Content="예약 적용"
                                            Style="{StaticResource NavButton}"
                                            Width="92"
                                            Height="30"
                                            Margin="8,0,12,0"
                                            Command="{Binding ApplyImageTrainingScheduleCommand}"/>
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding TrainingStatusMessage}"
                                               Foreground="#F3D36B"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
