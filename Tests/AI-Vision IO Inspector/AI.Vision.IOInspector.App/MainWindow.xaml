<Window x:Class="AI.Vision.IOInspector.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AI.Vision.IOInspector.App.Controls"
        xmlns:converters="clr-namespace:AI.Vision.IOInspector.App.Converters"
        Title="HD현대사이트솔루션 AI-Vision IO Inspector" Height="840" Width="1440"
        MinHeight="780" MinWidth="1240" WindowStartupLocation="CenterScreen"
        Background="#0B141B" FontFamily="Malgun Gothic">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:ImageFilePathConverter x:Key="ImageFilePathConverter"/>
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="#1D2A36"/>
            <Setter Property="BorderBrush" Value="#33495B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="#0A86D8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0A86D8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Background" Value="#9B2D2D"/>
            <Setter Property="BorderBrush" Value="#9B2D2D"/>
        </Style>
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="#F7F9FB"/>
            <Setter Property="BorderBrush" Value="#9AA8B5"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDE7EF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="InfoLabelCell" TargetType="Border">
            <Setter Property="Background" Value="#0E1A23"/>
            <Setter Property="BorderBrush" Value="#4B6070"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style x:Key="InfoValueCell" TargetType="Border">
            <Setter Property="Background" Value="#EDF3F7"/>
            <Setter Property="BorderBrush" Value="#4B6070"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style x:Key="ReadOnlyInfoTextBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="#0B141B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="30"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style x:Key="MainTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="MainTabItemStyle" TargetType="TabItem">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Foreground" Value="#C8D4DE"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="#172530"
                                BorderBrush="#33495B"
                                BorderThickness="1,1,1,0"
                                CornerRadius="4,4,0,0"
                                Padding="18,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#244154"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#0A86D8"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#45ADEC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SubTabItemStyle" TargetType="TabItem">
            <Setter Property="MinWidth" Value="118"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="#B8C7D4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="SubTabBorder"
                                Background="#14212B"
                                BorderBrush="#33495B"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="20,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SubTabBorder" Property="Background" Value="#203A4B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SubTabBorder" Property="Background" Value="#E8F2F8"/>
                                <Setter TargetName="SubTabBorder" Property="BorderBrush" Value="#7AA6BF"/>
                                <Setter Property="Foreground" Value="#10212C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#202C38" BorderBrush="#314353" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="150" Height="30" Background="#E8EEF3" CornerRadius="2" VerticalAlignment="Center" HorizontalAlignment="Left" Padding="6,3">
                    <Image Source="Assets/VLAD_Mon_Logo.png" Stretch="Uniform"/>
                </Border>
                <TextBlock Grid.Column="1" Text="Ops - 현대  |  AI-Vision IO Inspector" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding ApplicationVersionText}" Foreground="#B8C7D4" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource PanelBorder}" Grid.Row="0" Margin="0">
                    <StackPanel>
                        <TextBlock Text="SEARCH DB" Style="{StaticResource SectionTitle}"/>
                        <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" ToolTip="품번, 품명, 분류코드, 분류설명, 구분 검색"/>
                        <ItemsControl ItemsSource="{Binding MainSearchSuggestions}" Margin="0,6,0,0"
                                      Visibility="{Binding HasMainSearchSuggestions, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}"
                                                    Command="{Binding DataContext.ApplyMainSearchSuggestionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    Margin="0,0,14,0"
                                                    Foreground="#5BE37D"
                                                    FontWeight="SemiBold"
                                                    Cursor="Hand"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PanelBorder}" Grid.Row="2" Margin="0">
                    <StackPanel>
                        <TextBlock Text="PART INFORMATION" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{StaticResource InfoLabelCell}">
                                <TextBlock Text="품번" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource InfoValueCell}">
                                <TextBox Text="{Binding SelectedPart.PartNo, Mode=OneWay}" ToolTip="{Binding SelectedPart.PartNo}" Style="{StaticResource ReadOnlyInfoTextBox}"/>
                            </Border>
                            <Border Grid.Row="1" Style="{StaticResource InfoLabelCell}">
                                <TextBlock Text="품명" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource InfoValueCell}">
                                <TextBox Text="{Binding SelectedPart.PartName, Mode=OneWay}" ToolTip="{Binding SelectedPart.PartName}" Style="{StaticResource ReadOnlyInfoTextBox}"/>
                            </Border>
                            <Border Grid.Row="2" Style="{StaticResource InfoLabelCell}">
                                <TextBlock Text="분류코드" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource InfoValueCell}">
                                <TextBox Text="{Binding SelectedPart.CategoryCode, Mode=OneWay}" ToolTip="{Binding SelectedPart.CategoryCode}" Style="{StaticResource ReadOnlyInfoTextBox}"/>
                            </Border>
                            <Border Grid.Row="3" Style="{StaticResource InfoLabelCell}">
                                <TextBlock Text="분류설명" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource InfoValueCell}">
                                <TextBox Text="{Binding SelectedPart.CategoryDescription, Mode=OneWay}" ToolTip="{Binding SelectedPart.CategoryDescription}" Style="{StaticResource ReadOnlyInfoTextBox}"/>
                            </Border>
                            <Border Grid.Row="4" Style="{StaticResource InfoLabelCell}">
                                <TextBlock Text="구분" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource InfoValueCell}">
                                <TextBox Text="{Binding SelectedPart.PartType, Mode=OneWay}" ToolTip="{Binding SelectedPart.PartType}" Style="{StaticResource ReadOnlyInfoTextBox}"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="MEASUREMENT" Style="{StaticResource SectionTitle}" Margin="0,12,0,8"/>
                        <DataGrid ItemsSource="{Binding InspectionMeasurements}" IsReadOnly="True" RowHeight="26" MaxHeight="165"
                                  FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="측정부" Binding="{Binding PointName}" Width="70"/>
                                <DataGridTextColumn Header="항목" Binding="{Binding ItemType}" Width="*"/>
                                <DataGridTextColumn Header="기준" Binding="{Binding NominalValue}" Width="54"/>
                                <DataGridTextColumn Header="허용" Binding="{Binding Tolerance}" Width="68"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PanelBorder}" Grid.Row="4" Margin="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="EVENT" Style="{StaticResource SectionTitle}"/>
                        <DataGrid ItemsSource="{Binding EventRows}" IsReadOnly="True" FontSize="11"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="시간" Binding="{Binding Time}" Width="58"/>
                                <DataGridTextColumn Header="구분" Binding="{Binding Severity}" Width="58"/>
                                <DataGridTextColumn Header="내용" Binding="{Binding Message}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
            <TabControl Grid.Column="2"
                        SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                        Style="{StaticResource MainTabControlStyle}"
                        ItemContainerStyle="{StaticResource MainTabItemStyle}">
                <TabItem Header="검사">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource PanelBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="기준 이미지 저장" Style="{StaticResource NavButton}" Margin="0" Command="{Binding SaveCurrentCameraImagesCommand}"/>
                                <Button Grid.Column="1" Content="검사 시작" Style="{StaticResource NavButton}" Margin="10,0,0,0" Command="{Binding RunInspectionCommand}"/>
                                <Button Grid.Column="2" Content="화면 초기화" Style="{StaticResource NavButton}" Margin="10,0,0,0" Command="{Binding ResetInspectionScreenCommand}"/>
                                <StackPanel Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="상태: " Foreground="#B8C7D4" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="Bold"/>
                                    </StackPanel>
                                    <DockPanel Margin="0,4,0,0">
                                        <TextBlock DockPanel.Dock="Left" Text="결과: " Foreground="#B8C7D4" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ResultText}" Foreground="#5BE37D" FontWeight="Bold" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding ImageSlots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" Rows="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="4" Background="#E8E8E8" BorderBrush="{Binding ResultBorderBrush}" BorderThickness="{Binding ResultBorderThickness}" CornerRadius="4">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="32"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Border Background="#101820">
                                                <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Grid Grid.Row="1"
                                                  Background="#DDE3E7"
                                                  ClipToBounds="True"
                                                  Visibility="{Binding IsLiveInspectionViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="CAMERA" FontSize="24" FontWeight="SemiBold" Foreground="#7B8790" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding StatusText}" Foreground="#45515A" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                </StackPanel>
                                                <controls:RtspVideoHost StreamUrl="{Binding LiveStreamUrl}"
                                                                        IsStreaming="{Binding IsLiveStreamEnabled}"
                                                                        ReferenceImagePath="{Binding ReferenceImagePath}"
                                                                        Visibility="{Binding IsNativeStreamVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <Image Source="{Binding LiveImagePath, Converter={StaticResource ImageFilePathConverter}}"
                                                       Stretch="Uniform"
                                                       Visibility="{Binding IsCapturedStillVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <Border HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Margin="8"
                                                        Background="#B73535"
                                                        CornerRadius="3"
                                                        Padding="8,3"
                                                        Opacity="0.92"
                                                        Visibility="{Binding IsReferenceImageMissing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="기준 이미지 없음" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                                </Border>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Background="{Binding ResultBrush}" CornerRadius="3" Padding="8,2" Opacity="0.96">
                                                    <TextBlock Text="{Binding ResultText}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                            <Grid Grid.Row="1"
                                                  Background="#0C151C"
                                                  Visibility="{Binding IsInspectionCompletedViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid>
                                                    <Image
                                                           Source="{Binding LiveImagePath, Converter={StaticResource ImageFilePathConverter}}"
                                                           Stretch="Uniform"
                                                           Margin="2"/>

                                                    <Grid Panel.ZIndex="2">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="1*"/>
                                                            <RowDefinition Height="3*"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1*"/>
                                                            <ColumnDefinition Width="2*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Row="0"
                                                            Grid.Column="0"
                                                            Margin="7"
                                                            Background="#E80C151C"
                                                            BorderBrush="#8DA9BB"
                                                            BorderThickness="2"
                                                            CornerRadius="3">
                                                            <Grid>
                                                                <Image Source="{Binding ReferenceImagePath, Converter={StaticResource ImageFilePathConverter}}"
                                                                   Stretch="Uniform"
                                                                   Margin="2"/>
                                                                <Border HorizontalAlignment="Left"
                                                                    VerticalAlignment="Top"
                                                                    Background="#D90E1A23"
                                                                    Padding="6,2">
                                                                    <TextBlock Text="기준 이미지" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                                </Border>
                                                                <TextBlock Text="기준 이미지 없음"
                                                                       Foreground="White"
                                                                       FontSize="10"
                                                                       FontWeight="Bold"
                                                                       TextWrapping="Wrap"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Visibility="{Binding IsReferenceImageMissing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>

                                                    <Border HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Margin="7"
                                                            Background="{Binding ResultBrush}"
                                                            CornerRadius="3"
                                                            Padding="10,3"
                                                            Panel.ZIndex="3">
                                                        <TextBlock Text="{Binding ResultText}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                                    </Border>
                                                    <Border HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Background="#7A000000"
                                                            CornerRadius="4"
                                                            Padding="18,4"
                                                            IsHitTestVisible="False"
                                                            Panel.ZIndex="3">
                                                        <TextBlock Text="{Binding ResultText}"
                                                                   Foreground="{Binding ResultBrush}"
                                                                   FontSize="30"
                                                                   FontWeight="Black">
                                                            <TextBlock.Effect>
                                                                <DropShadowEffect Color="White" Direction="315" ShadowDepth="1" BlurRadius="0"/>
                                                            </TextBlock.Effect>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </TabItem>
                <TabItem Header="DB 조회/확인">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource PanelBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="품번" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding SearchPartNo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                                <TextBlock Grid.Column="2" Text="품명" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <TextBox Grid.Column="3" Text="{Binding SearchPartName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                                <TextBlock Grid.Column="4" Text="분류코드" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <TextBox Grid.Column="5" Text="{Binding SearchCategoryCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                                <TextBlock Grid.Column="6" Text="분류설명" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <TextBox Grid.Column="7" Text="{Binding SearchCategoryDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                                <ItemsControl Grid.Row="1" Grid.ColumnSpan="9" ItemsSource="{Binding DbSearchSuggestions}" Margin="90,6,0,0"
                                              Visibility="{Binding HasDbSearchSuggestions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}"
                                                    Command="{Binding DataContext.ApplyDbSearchSuggestionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    Margin="0,0,18,0"
                                                    Foreground="#5BE37D"
                                                    FontWeight="SemiBold"
                                                    Cursor="Hand"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="330"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="1.0*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="1.3*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PanelBorder}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="DB 조회/확인" Style="{StaticResource SectionTitle}"/>
                                        <DataGrid ItemsSource="{Binding DbParts}"
                                                  SelectedItem="{Binding SelectedDbPart, Mode=TwoWay}"
                                                  IsReadOnly="True"
                                                  PreviewKeyDown="OnSingleCellDataGridPreviewKeyDown"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="품번" Binding="{Binding PartNo, Mode=OneWay}" Width="120"/>
                                                <DataGridTextColumn Header="품명" Binding="{Binding PartName, Mode=OneWay}" Width="150"/>
                                                <DataGridTextColumn Header="분류코드" Binding="{Binding CategoryCode, Mode=OneWay}" Width="90"/>
