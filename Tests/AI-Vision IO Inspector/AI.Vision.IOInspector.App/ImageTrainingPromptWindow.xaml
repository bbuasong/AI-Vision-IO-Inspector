<Window x:Class="AI.Vision.IOInspector.App.ImageTrainingPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="이미지 학습 실행"
        Width="460"
        Height="250"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#101A22"
        FontFamily="Malgun Gothic">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageTextBlock"
                   Foreground="#DDE7EF"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Margin="0,0,0,14"/>

        <StackPanel Grid.Row="1">
            <RadioButton x:Name="StartNowRadioButton"
                         Content="학습 지금 실행"
                         Foreground="White"
                         FontWeight="SemiBold"
                         IsChecked="True"
                         Checked="OnModeChanged"
                         Margin="0,0,0,12"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="118"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="ScheduleRadioButton"
                             Content="예약시간 설정"
                             Foreground="White"
                             FontWeight="SemiBold"
                             Checked="OnModeChanged"
                             VerticalAlignment="Center"/>
                <DatePicker x:Name="ScheduleDatePicker"
                            Grid.Column="1"
                            Height="28"
                            Margin="0,0,8,0"/>
                <TextBox x:Name="ScheduleTimeTextBox"
                         Grid.Column="2"
                         Height="28"
                         Padding="6,3"
                         ToolTip="HH:mm"/>
            </Grid>
            <TextBlock Text="예약시간 형식: 날짜 + HH:mm"
                       Foreground="#9FB0BD"
                       FontSize="11"
                       Margin="118,6,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="확인"
                    Width="84"
                    Height="30"
                    Margin="0,0,8,0"
                    Click="OnOkClick"/>
            <Button Content="취소"
                    Width="84"
                    Height="30"
                    Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</Window>
