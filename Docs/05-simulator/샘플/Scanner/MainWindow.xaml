<Window x:Class="ScannerSample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Scanner OCR Sample"
        Width="1120"
        Height="620"
        MinWidth="980"
        MinHeight="520"
        Background="#F5F7FA">
    <Window.Resources>
        <Style x:Key="CommandButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ResultTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="GridCellTextStyle" TargetType="TextBlock">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Epson ES-C320W Scanner OCR Sample"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#0F172A"/>

        <TextBlock Grid.Row="1"
                   Text="{Binding ScanSettingsSummary}"
                   Margin="0,6,0,0"
                   Foreground="#475569"/>

        <Grid Grid.Row="2" Margin="0,16,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Start Scan"
                    Style="{StaticResource CommandButtonStyle}"
                    Command="{Binding StartScanCommand}"/>

            <Button Grid.Column="1"
                    Content="Read Image File"
                    Margin="10,0,0,0"
                    Style="{StaticResource CommandButtonStyle}"
                    Command="{Binding ReadImageFileCommand}"/>

            <Button Grid.Column="2"
                    Content="Open Image Folder"
                    Margin="10,0,0,0"
                    Style="{StaticResource CommandButtonStyle}"
                    Command="{Binding OpenImageFolderCommand}"/>

            <Button Grid.Column="3"
                    Content="결과 초기화"
                    Margin="10,0,0,0"
                    Style="{StaticResource CommandButtonStyle}"
                    Command="{Binding ClearResultsCommand}"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Sdcb.PaddleOCR"
                           Margin="0,0,0,4"
                           Foreground="#475569"
                           FontWeight="SemiBold"/>
                <TextBox Style="{StaticResource ResultTextBoxStyle}"
                         Text="{Binding LastPaddleOcrCode, Mode=OneWay}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                <TextBlock Text="Windows 내장"
                           Margin="0,0,0,4"
                           Foreground="#475569"
                           FontWeight="SemiBold"/>
                <TextBox Style="{StaticResource ResultTextBoxStyle}"
                         Text="{Binding LastWindowsOcrCode, Mode=OneWay}"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                <TextBlock Text="C# Epson API"
                         Margin="0,0,0,4"
                         Foreground="#475569"
                         FontWeight="SemiBold"/>
                <TextBox Style="{StaticResource ResultTextBoxStyle}"
                         Text="{Binding LastCSharpEpsonApiCode, Mode=OneWay}"/>
            </StackPanel>
        </Grid>

        <DataGrid Grid.Row="4"
                  ItemsSource="{Binding ScanResults}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  BorderBrush="#CBD5E1"
                  BorderThickness="1"
                  Background="White"
                  AlternatingRowBackground="#F8FAFC"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time"
                                    Binding="{Binding ScannedAtText}"
                                    Width="140"
                                    ElementStyle="{StaticResource GridCellTextStyle}"/>
                <DataGridTextColumn Header="Sdcb.PaddleOCR"
                                    Binding="{Binding PaddleOcrCodeText}"
                                    Width="*"
                                    MinWidth="150"
                                    ElementStyle="{StaticResource GridCellTextStyle}"/>
                <DataGridTextColumn Header="Windows 내장"
                                    Binding="{Binding WindowsOcrCodeText}"
                                    Width="*"
                                    MinWidth="150"
                                    ElementStyle="{StaticResource GridCellTextStyle}"/>
                <DataGridTextColumn Header="C# Epson API"
                                    Binding="{Binding CSharpEpsonApiCodeText}"
                                    Width="*"
                                    MinWidth="150"
                                    ElementStyle="{StaticResource GridCellTextStyle}"/>
                <DataGridTextColumn Header="Selected"
                                    Binding="{Binding CodeText}"
                                    Width="150"
                                    ElementStyle="{StaticResource GridCellTextStyle}"/>
                <DataGridTextColumn Header="Engine"
                                    Binding="{Binding OcrEngineName}"
                                    Width="130"
                                    ElementStyle="{StaticResource GridCellTextStyle}"/>
                <DataGridTextColumn Header="Rotation"
                                    Binding="{Binding RotationText}"
                                    Width="90"
                                    ElementStyle="{StaticResource GridCellTextStyle}"/>
                <DataGridTextColumn Header="Image"
                                    Binding="{Binding ImageFileName}"
                                    Width="220"
                                    ElementStyle="{StaticResource GridCellTextStyle}"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="5"
                   Text="{Binding StatusMessage}"
                   Margin="0,10,0,0"
                   Foreground="#475569"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
