<Window x:Class="EpsonScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Epson Scanner" Height="700" Width="1160"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="160" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Start Scan" Width="120" Height="36" Command="{Binding StartScanCommand}" />
            <Button Content="Sample Image" Width="120" Height="36" Margin="8,0,0,0" Command="{Binding SampleCommand}" />
            <TextBlock Text="Detected ID" VerticalAlignment="Center" Margin="20,0,8,0" />
            <TextBox Text="{Binding DetectedText, UpdateSourceTrigger=PropertyChanged}" Width="240" Height="32" FontSize="17" VerticalContentAlignment="Center" />
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="20,0,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Detected List" FontWeight="Bold" Margin="0,0,0,5" />
        <ListBox Grid.Row="2" ItemsSource="{Binding DetectedList}" FontSize="17" />

        <TextBlock Grid.Row="3" Text="Scan Log" FontWeight="Bold" Margin="0,12,0,5" />
        <DataGrid Grid.Row="4" ItemsSource="{Binding Logs}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Time, StringFormat=yyyy-MM-dd HH:mm:ss.fff}" Width="175" />
                <DataGridTextColumn Header="판별 ID" Binding="{Binding JudgeId}" Width="130" />
                <DataGridTextColumn Header="Raw Path" Binding="{Binding RawImagePath}" Width="240" />
                <DataGridTextColumn Header="Label Path" Binding="{Binding LabelImagePath}" Width="240" />
                <DataGridTextColumn Header="Crop Path" Binding="{Binding CropImagePath}" Width="240" />
                <DataGridTextColumn Header="Rotation" Binding="{Binding Rotation}" Width="80" />
                <DataGridTextColumn Header="OCR Raw" Binding="{Binding RawOcrText}" Width="180" />
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="220" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
