<?xml version="1.0" encoding="utf-8"?>
<!--
  납품용 게시 프로파일: x86 + 독립 실행형(self-contained).
  .NET 런타임까지 포함되어 고객 PC에 .NET 설치 없이 실행된다.
  ★ 출력 위치를 '소스 폴더 밖'(D:\epson_deploy\win-x86)으로 고정 → 소스 폴더에 절대 안 섞임.
    rapid_sidecar.exe(CopyToOutputDirectory)도 거기에 함께 복사된다.

  사용:
   - Visual Studio:  프로젝트 우클릭 → 게시 → 이 프로파일 → 게시 버튼
   - CLI:            dotnet publish -p:PublishProfile=win-x86-selfcontained
  결과 폴더(D:\epson_deploy\win-x86)를 통째로 zip해서 고객에게 전달.
  (출력 위치를 바꾸려면 아래 PublishDir 만 수정)
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <_TargetId>Folder</_TargetId>
    <Configuration>Release</Configuration>
    <Platform>x86</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <!-- bin 폴더 아래(Debug/Release와 나란히). 프로젝트 기준 상대경로 -->
    <PublishDir>bin\Publish\EpsonScanApi-win-x86\</PublishDir>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
