<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>EpsonScanTester</RootNamespace>
    <AssemblyName>EpsonScanTester</AssemblyName>
  </PropertyGroup>

  <!-- net472 에는 System.Text.Json 이 기본 포함되지 않으므로 패키지로 추가.
       (IO Inspector 와 같은 6.0.10 버전으로 맞춤) -->
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="6.0.10" />
  </ItemGroup>

  <!-- HttpClient 가 들어있는 프레임워크 어셈블리 -->
  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
