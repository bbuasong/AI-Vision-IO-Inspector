<Window x:Class="BarcodeScannerSample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Barcode Scanner Sample"
        Width="720"
        Height="460"
        MinWidth="560"
        MinHeight="360"
        Background="#F5F7FA">
    <Window.Resources>
        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Epson ES-C320W Barcode Scan Sample"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#0F172A"/>

        <TextBlock Grid.Row="1"
                   Text="{Binding ScanSettingsSummary}"
                   Margin="0,6,0,0"
                   Foreground="#475569"/>

        <Grid Grid.Row="2" Margin="0,16,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Barcode"
                       Margin="0,0,10,0"
                       Style="{StaticResource LabelTextStyle}"/>

            <TextBox x:Name="BarcodeInputBox"
                     Grid.Column="1"
                     Height="34"
                     Padding="8,5"
                     FontSize="14"
                     IsEnabled="{Binding IsReadingActive}"
                     Text="{Binding CurrentBarcode, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding AddBarcodeCommand}"/>
                </TextBox.InputBindings>
            </TextBox>

            <Button x:Name="StartReadingButton"
                    Grid.Column="2"
                    Content="Start Reading"
                    Margin="10,0,0,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding StartBarcodeReadingCommand}"/>

            <Button Grid.Column="3"
                    Content="Decode Image File"
                    Margin="10,0,0,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding DecodeImageFileCommand}"/>

            <Button Grid.Column="4"
                    Content="ListBox 초기화"
                    Margin="10,0,0,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding ClearBarcodesCommand}"/>
        </Grid>

        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="1">
            <ListBox ItemsSource="{Binding BarcodeItems}"
                     BorderThickness="0"
                     FontSize="14"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="6,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding ScannedAtText}"
                                       Foreground="#64748B"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding BarcodeText}"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding ImageFileName}"
                                       Foreground="#64748B"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock Grid.Row="4"
                   Text="{Binding StatusMessage}"
                   Margin="0,10,0,0"
                   Foreground="#475569"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
