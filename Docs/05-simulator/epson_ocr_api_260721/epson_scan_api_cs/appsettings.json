{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ScanOutputDir": "D:\\epson_scans",
  "ScanApiHost": "127.0.0.1",
  "ScanApiPort": 8000,
  "AllowedHosts": "*",

  "RapidSidecarUrl": "http://127.0.0.1:8011",
  "RapidSidecarExe": "rapid_sidecar.exe",
  "RapidPythonExe": "pyruntime\\python.exe",
  "RapidSidecarScript": "rapid_sidecar.py",

  "Tuning": {
    "Ocr": {
      "MinLetters": 40,
      "MinRatio": 0.80,
      "RequiredAnchors": [ "EA" ],
      "PartNoPattern": "[A-Za-z0-9]+(?:[-‐-―][A-Za-z0-9]+)*",
      "PartNoBrackets": "()[]{}<>«»‹›＜＞｛｝〈〉《》",
      "DefaultDpi": 300
    },
    "Card": {
      "MarginFrac": 0.04,
      "InkCap": 150,
      "DeskewDim": 1100,
      "DeskewRange": 20,
      "DeskewCoarse": 1.0,
      "DeskewFine": 0.2,
      "BarcodeBandMinCount": 8
    }
  }
}
