<Window x:Class="TrainingProcessMonitor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF Training Process Monitor" Height="760" Width="1120"
        MinHeight="680" MinWidth="980" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="WPF Monitor Program" FontSize="20" FontWeight="SemiBold" />
            <TextBlock DockPanel.Dock="Right" Text="Start 버튼 → Training UI 실행 → stdout 수신" Foreground="#5B6472" />
        </DockPanel>

        <GroupBox Grid.Row="1" Header="Training 프로그램 실행">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="132" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Training EXE" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ExternalTrainingExePath, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Row="0" Grid.Column="2" Content="찾기" Command="{Binding BrowseExternalExeCommand}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Job Root" />
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding JobRootPath, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Start" MinWidth="132" Command="{Binding StartTrainingCommand}" />
                    <Button Content="종료" Command="{Binding CancelTrainingCommand}" />
                    <Button Content="Grid 지우기" Command="{Binding ClearReceivedMessagesCommand}" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="현재 상태">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="132" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="상태" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Status}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Job ID" />
                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding CurrentJobId}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="진행률" />
                <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="64" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Grid.Column="0" Height="24" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" />
                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding ProgressText}" />
                </Grid>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="현재 메시지" />
                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding CurrentMessage}" TextWrapping="Wrap" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="에러 코드" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ErrorCode}" Foreground="#B3261E" />
                <TextBlock Grid.Row="3" Grid.Column="2" Text="에러 메시지" />
                <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding ErrorMessage}" Foreground="#B3261E" TextWrapping="Wrap" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="시작/종료/경과" />
                <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding TimeSummary}" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Training 프로그램에서 받은 정보 Grid">
            <DataGrid ItemsSource="{Binding ReceivedMessages}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                      GridLinesVisibility="Horizontal" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="105" />
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="90" />
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110" />
                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="90" />
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="260" />
                    <DataGridTextColumn Header="Raw" Binding="{Binding Raw}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</Window>

